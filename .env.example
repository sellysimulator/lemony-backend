# Application
DEBUG=false
HOST=0.0.0.0
PORT=8080

# Must never be ["*"]: the app sets allow_credentials=True.
CORS_ORIGINS=["http://localhost:5173"]

# Database (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=lemony
DB_REQUIRE_SSL=false
DB_SSL_CA=

# Live game state.
#   false (default) — games in progress are stored in the `live_games` table,
#     so a restart/redeploy does not lose them. The per-game lock lives in this
#     process: run exactly ONE instance with no `--workers`.
#   true — games live in Redis and Socket.IO fans out through it; more than one
#     instance works. REDIS_URL is then required.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Seconds a live game survives after its last save.
GAME_TTL_SECONDS=604800

# Firebase service account JSON, on a single line, single-quoted or unquoted
# (double quotes corrupt the \n inside private_key).
FIREBASE_SERVICE_ACCOUNT_JSON=
