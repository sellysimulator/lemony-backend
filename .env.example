# Application
DEBUG=false
HOST=0.0.0.0
PORT=8080

# Must never be ["*"]: the app sets allow_credentials=True.
CORS_ORIGINS=["http://localhost:5173"]

# Database (PostgreSQL 18, driver psycopg 3). Credentials may hold any
# character: the app percent-encodes them into the URL. These values are a
# local Docker PostgreSQL 18, which everyday development uses. Production is
# Lemony's own Neon project: DB_HOST is Neon's DIRECT endpoint
# (ep-....us-east-1.aws.neon.tech, WITHOUT -pooler: the pooled endpoint rejects
# the `options=-c timezone=UTC` startup parameter the app sends), DB_USER
# neondb_owner. A backend run locally against Neon is one more instance and
# takes the game over its 50-connection budget during a deploy (CLAUDE.md, Deploy).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=lemonydb
# TLS is required by default (sslmode=require); false only for a local
# PostgreSQL without TLS (the Docker one above, with DB_SSL_CA empty); true
# against Neon. DB_SSL_CA is the Let's Encrypt
# roots ISRG Root X1 + ISRG Root X2 in one PEM bundle (Neon's certificates chain
# to them), the same file for all four games, and adds certificate and
# hostname verification (sslmode=verify-full; DB_HOST must then be the
# hostname, not an IP). Either the PEM text -- ONE line, UNQUOTED, \n between
# the PEM lines, as printed by `awk '{printf "%s\\n", $0}' neon-ca.pem` --
# or a path to a PEM file (locally <Novus>/novus-secrets/neon-ca.pem).
# Not a secret. A value that is neither stops the app at boot.
DB_REQUIRE_SSL=false
DB_SSL_CA=
# Connections per instance: the pool keeps DB_POOL_SIZE open and opens up to
# DB_MAX_OVERFLOW more on demand (24 in all). Lemony's budget on its Neon
# project is 50 connections, deploys included: two instances during a deploy
# (48), its alembic (1) and one psql (1) (CLAUDE.md, Deploy).
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=4

# Live game state.
#   false (default) — games in progress are stored in the PostgreSQL `live_games` table,
#     so a restart/redeploy does not lose them. The per-game lock lives in this
#     process: run exactly ONE instance with no `--workers`.
#   true — games live in Redis and Socket.IO fans out through it; more than one
#     instance works. REDIS_URL is then required.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Seconds a live game survives after its last save. A guest's game: at most 2 days
# (GUEST_GAME_TTL_SECONDS in app/services/state_service.py).
GAME_TTL_SECONDS=604800

# Firebase service account JSON, on a single line, single-quoted or unquoted
# (double quotes corrupt the \n inside private_key).
FIREBASE_SERVICE_ACCOUNT_JSON=
